# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB Atlas connection string, including the database name (database.md §2)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/linkbase?retryWrites=true&w=majority

# Signs and encrypts the session token — generate with: openssl rand -base64 32 (auth.md §1)
AUTH_SECRET=

# Canonical origin. Leave unset on Vercel (inferred); required when running the
# Docker image or any other self-hosted server (deployment.md §6.4)
AUTH_URL=
